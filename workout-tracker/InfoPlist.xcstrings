    "NSHealthShareUsageDescription" : {
      "comment" : "Required by App Store for HealthKit apps; the app never reads Health data.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app only saves your finished workouts to Apple Health and does not read any Health data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app solo guarda tus entrenamientos terminados en Apple Salud y no lee ningún dato de Salud."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение только сохраняет завершённые тренировки в Apple Здоровье и не читает данные «Здоровья»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama yalnızca bitirdiğin antrenmanları Apple Sağlık'a kaydeder, Sağlık verilerini okumaz."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Shown when asking to write workouts to Apple Health.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your finished workouts are saved to Apple Health as strength training."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus entrenamientos terminados se guardan en Apple Salud como entrenamiento de fuerza."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завершённые тренировки сохраняются в Apple Здоровье как силовые."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitirdiğin antrenmanlar Apple Sağlık'a kuvvet antrenmanı olarak kaydedilir."
          }
        }
      }
